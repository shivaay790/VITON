# Copy to backend/.env and fill in. backend/.env is gitignored, never commit it.

# --- Semantic search (optional) ---------------------------------------------
# Without these the shop still works, using metadata filtering instead.
# Key: https://app.pinecone.io -> API Keys. Host: the index's URL in the console.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=

# --- Dataset (optional) -----------------------------------------------------
# Defaults to ../../clothes_tryon_dataset relative to backend/, i.e. a
# clothes_tryon_dataset folder next to the repository.
# DATASET_DIR=D:/data/clothes_tryon_dataset
# DATASET_SPLIT=train

# --- Try-on model (optional) ------------------------------------------------
# DMVTON_CHECKPOINT_DIR=feature_2_VITON_model/DM-VTON/checkpoints
# TRYON_DEVICE=cuda
